// Conservative tool/output surface for real local provider ids only:
// local, ollama, lm-studio. `tiny` and `lmstudio` are not registered
// providers. llama.cpp and vllm are intentionally absent — those hosts
// were not downgraded by provider id alone. Model-name `tiny` substrings
// are not a contract; nested `tiny-local-surface #false` still overrides
// a host assignment.

provider "local" {
	tiny-local-surface #true
}

provider "ollama" {
	tiny-local-surface #true
}

provider "lm-studio" {
	tiny-local-surface #true
}
